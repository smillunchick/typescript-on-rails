{
  "name": "typescript-on-rails",
  "version": "0.1.0",
  "description": "An agent-native TypeScript application architecture kernel and compiler with runtime contract primitives.",
  "keywords": [
    "typescript",
    "framework",
    "architecture",
    "agent-native",
    "static-analysis"
  ],
  "license": "MIT",
  "author": "Sam Millunchick",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smillunchick/typescript-on-rails.git"
  },
  "bugs": {
    "url": "https://github.com/smillunchick/typescript-on-rails/issues"
  },
  "homepage": "https://github.com/smillunchick/typescript-on-rails#readme",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "typescriptOnRails": {
    "packageCapabilities": {
      "typescript": "host-io"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "app": "dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./architecture": {
      "types": "./dist/features/architecture/index.d.ts",
      "import": "./dist/features/architecture/index.js"
    },
    "./testing": {
      "types": "./dist/features/testing/index.d.ts",
      "import": "./dist/features/testing/index.js"
    },
    "./tooling": {
      "types": "./dist/features/tooling/index.d.ts",
      "import": "./dist/features/tooling/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\"",
    "build": "tsc -p tsconfig.json",
    "emit": "tsc -p tsconfig.json --noCheck",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p examples/reference-saas/tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts && npm --prefix examples/reference-saas run test:app",
    "architecture:check": "node dist/bin.js check",
    "reference:check": "npm --prefix examples/reference-saas run check",
    "check": "npm run typecheck && npm test && npm run emit && npm run architecture:check && npm run reference:check",
    "prepack": "npm run clean && npm run build",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsx": "^4.20.6"
  }
}

{
  "name": "typescript-on-rails-reference-fullstack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.7" },
  "scripts": {
    "dev": "node ../../dist/bin.js dev",
    "build": "node ../../dist/bin.js build",
    "test": "node ../../dist/bin.js test",
    "precheck": "npm --prefix ../.. run packages:runtime-build",
    "check": "npm run check:architecture",
    "check:architecture": "node ../../dist/bin.js check --with-tests",
    "migrate": "node ../../dist/bin.js migrate",
    "worker": "node ../../dist/bin.js worker",
    "scheduler": "node ../../dist/bin.js scheduler",
    "seed": "node ../../dist/bin.js seed",
    "dev:runtime": "next dev --experimental-https --hostname localhost --port 3420",
    "build:runtime": "next build",
    "test:runtime": "node --import tsx --test",
    "check:runtime": "tsc -p tsconfig.json --noEmit",
    "migrate:runtime": "node --import tsx tools/migrate.ts",
    "seed:runtime": "node --import tsx tools/seed.ts"
  },
  "dependencies": {
    "@typescript-on-rails/fullstack": "0.1.0",
    "@typescript-on-rails/jobs": "0.1.0",
    "@typescript-on-rails/postgres": "0.1.0",
    "@typescript-on-rails/testing": "0.1.0",
    "@typescript-on-rails/web": "0.1.0",
    "kysely": "0.29.4",
    "next": "16.3.3",
    "pg": "8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript-on-rails": "file:../.."
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsx": "^4.20.6",
    "typescript": "5.9.3"
  },
  "typescriptOnRails": {
    "packageCapabilities": {}
  }
}

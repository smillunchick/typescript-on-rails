{
  "name": "@typescript-on-rails/web",
  "version": "0.1.0",
  "description": "Host-neutral HTTP runtime and maintained Next/React bindings for TypeScript on Rails.",
  "repository": { "type": "git", "url": "git+https://github.com/smillunchick/typescript-on-rails.git", "directory": "packages/web" },
  "bugs": { "url": "https://github.com/smillunchick/typescript-on-rails/issues" },
  "homepage": "https://github.com/smillunchick/typescript-on-rails#readme",
  "publishConfig": { "access": "public" },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./next": { "types": "./dist/next.d.ts", "import": "./dist/next.js" },
    "./react": { "types": "./dist/react.d.ts", "import": "./dist/react.js" },
    "./react-render": {
      "types": "./dist/react-render.d.ts",
      "import": "./dist/react-render.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": { "build": "tsc -p tsconfig.json", "typecheck": "tsc -p tsconfig.test.json", "test": "node --import tsx --test test/*.test.ts", "check": "npm run typecheck && npm test && npm run build", "prepack": "npm run build" },
  "peerDependencies": { "react": "^19.0.0", "react-dom": "^19.0.0", "typescript-on-rails": "^0.1.0" },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "react-dom": { "optional": true }
  },
  "devDependencies": { "@types/node": "^24.10.0", "@types/react": "^19.2.0", "@types/react-dom": "^19.2.0", "react": "19.2.8", "react-dom": "19.2.8", "tsx": "^4.20.6", "typescript": "5.9.3", "typescript-on-rails": "file:../.." },
  "engines": { "node": ">=22" },
  "license": "MIT"
}

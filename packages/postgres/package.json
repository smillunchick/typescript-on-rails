{
  "name": "@typescript-on-rails/postgres",
  "version": "0.1.0",
  "description": "PostgreSQL and Kysely runtime for TypeScript on Rails.",
  "repository": { "type": "git", "url": "git+https://github.com/smillunchick/typescript-on-rails.git", "directory": "packages/postgres" },
  "bugs": { "url": "https://github.com/smillunchick/typescript-on-rails/issues" },
  "homepage": "https://github.com/smillunchick/typescript-on-rails#readme",
  "publishConfig": { "access": "public" },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": { "build": "tsc -p tsconfig.json", "typecheck": "tsc -p tsconfig.test.json", "test": "node --import tsx --test test/*.test.ts", "check": "npm run typecheck && npm test && npm run build", "prepack": "npm run build" },
  "dependencies": { "kysely": "^0.29.4", "pg": "^8.22.0" },
  "peerDependencies": { "typescript-on-rails": "^0.1.0" },
  "devDependencies": { "@types/node": "^24.10.0", "@types/pg": "8.20.0", "tsx": "^4.20.6", "typescript": "5.9.3", "typescript-on-rails": "file:../.." },
  "typescriptOnRails": {
    "packageFactsVersion": 1,
    "packageFacts": [
      { "package": "@typescript-on-rails/postgres", "capability": "host-io", "runtime": ["server"], "effects": ["database", "network"], "nondeterminism": ["external"] },
      { "package": "kysely", "capability": "host-io", "runtime": ["server"], "effects": ["database"], "nondeterminism": ["external"] },
      { "package": "pg", "capability": "host-io", "runtime": ["server"], "effects": ["database", "network"], "nondeterminism": ["external"] }
    ]
  },
  "engines": { "node": ">=22" },
  "license": "MIT"
}

{
  "name": "typescript-on-rails-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.7" },
  "scripts": {
    "dev": "app dev",
    "build": "app build",
    "test": "app test",
    "check": "app check --with-tests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev:runtime": "next dev --hostname localhost --port 3420",
    "build:runtime": "next build",
    "test:runtime": "node --import tsx --test",
    "check:runtime": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@typescript-on-rails/fullstack": "0.1.0",
    "@typescript-on-rails/web": "0.1.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript-on-rails": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  },
  "typescriptOnRails": {
    "packageCapabilities": {}
  }
}
